pragma solidity ^0.8.20;

/**
 * @title STProof v6.6 - 事实资产协议（最终经济模型版）
 * @author STProof Team
 * @notice 
 * 核心特性：
 * 1. 阶梯式引用定价（社交/证据/商业三级）
 * 2. 引用即价值交换：引用他人提升自身资产底价，形成双赢经济模型
 * 3. 证据哈希防篡改：铸造时存储 keccak256(cid) 并支持验证
 * 4. 防刷机制：单地址对单资产仅可引用一次
 * 5. DAG 引用网络 + 策展故事线 + 手动提现
 */
contract STProofV66 {
    using Strings for uint256;

    // ==================== 常量与配置 ====================
    string public constant NAME = "STProof";
    string public constant SYMBOL = "STP";
    string public constant VERSION = "6.6";

    // 阶梯引用定价 (单位: wei)
    uint256 public constant FEE_SOCIAL = 0.00001 ether;      // 社交级 ≈ $0.03
    uint256 public constant FEE_EVIDENCE = 0.0001 ether;     // 证据级 ≈ $0.30
    uint256 public constant FEE_COMMERCIAL = 0.001 ether;    // 商业级 ≈ $3.00

    // 引用权重 (定点数 1e18 = 1.0)
    uint256 public constant WEIGHT_SOCIAL = 0.1e18;
    uint256 public constant WEIGHT_EVIDENCE = 1e18;
    uint256 public constant WEIGHT_COMMERCIAL = 10e18;

    uint256 public constant ACCESS_FEE = 0.001 ether;
    uint256 public constant MIN_VALIDATORS = 2;
    uint256 public constant MAX_EDITIONS = 10000;

    // 收益分配
    uint256 public constant CREATOR_SHARE = 70;
    uint256 public constant TREASURY_SHARE = 28;
    uint256 public constant PROTOCOL_SHARE = 2;

    // ==================== 数据结构 ====================
    struct EventProof {
        string eventName;
        string cid;
        address creator;
        uint256 createTime;
        bool verified;
        uint256 citations;
        uint256 revenue;
        address[] validators;
        uint256 schemaId;
        uint256 editionNumber;
        uint256 totalEditions;
    }

    struct Citation {
        address citer;
        uint256 timestamp;
        uint8 level;
        uint256 fee;
        uint256 weight;
    }

    struct Attestation {
        address validator;
        string commentCID;
        uint256 timestamp;
    }

    struct Storyline {
        uint256 id;
        string title;
        string description;
        address creator;
        uint256 createdAt;
        uint256 updatedAt;
        uint256[] tokenIds;
        uint256 upvoteCount;
        bool isPublic;
    }

    // ==================== 状态变量 ====================
    address private _owner;
    address public treasury;
    address public protocolCreator;

    uint256 private _tokenIdCounter;
    uint256 public storylineCounter;

    // ERC721
    mapping(uint256 => address) private _owners;
    mapping(address => uint256) private _balances;
    mapping(uint256 => address) private _tokenApprovals;
    mapping(address => mapping(address => bool)) private _operatorApprovals;

    // 事实资产
    mapping(uint256 => EventProof) public events;
    mapping(uint256 => string[]) public evidenceHistory;
    mapping(uint256 => uint256) public evidenceCount;
    mapping(string => bool) public evidenceCIDMinted;

    // 证据哈希（防篡改）
    mapping(uint256 => bytes32) public cidHashs;

    // 引用网络
    mapping(uint256 => Citation[]) public citations;
    mapping(uint256 => mapping(address => bool)) public hasCited;
    mapping(uint256 => uint256) public citationCount;
    mapping(uint256 => uint256) public citationWeightedSum;

    // 验证者系统
    mapping(address => bool) public validators;
    address[] public validatorList;
    mapping(uint256 => Attestation[]) public attestations;

    // 收益提现系统
    mapping(address => uint256) public pendingCreatorRevenue;
    uint256 public pendingTreasuryRevenue;
    uint256 public pendingProtocolCreatorRevenue;
    uint256 public treasuryBalance;
    uint256 public creatorBalance;

    // 版税
    mapping(uint256 => address) private _royaltyRecipients;
    mapping(uint256 => uint256) private _royaltyRates;

    // 元数据
    string private _baseURI = "https://stproof.org/api/metadata/";
    mapping(uint256 => string) private _tokenURIs;

    // 策展故事线
    mapping(uint256 => Storyline) public storylines;
    mapping(address => uint256[]) public storylinesByCreator;
    mapping(uint256 => mapping(address => bool)) public storylineUpvotes;

    // 事件
    event Minted(uint256 indexed tokenId, string name, address indexed creator, uint256 schemaId);
    event EditionSetMinted(string indexed cid, uint256 totalEditions, address creator);
    event Verified(uint256 indexed tokenId, address indexed validator);
    event AttestationAdded(uint256 indexed tokenId, address indexed validator, string commentCID);
    event Cited(uint256 indexed tokenId, address indexed citer, uint8 level, uint256 fee, uint256 weight);
    event EvidenceAdded(uint256 indexed tokenId, string newCID);
    event RevenueWithdrawn(address indexed recipient, uint256 amount, string role);
    event StorylineCreated(uint256 indexed storylineId, address indexed creator, string title);
    event TokenAddedToStoryline(uint256 indexed storylineId, uint256 indexed tokenId);
    event StorylineUpvoted(uint256 indexed storylineId, address indexed voter);

    // 修饰器
    modifier onlyOwner() {
        require(msg.sender == _owner, "Not owner");
        _;
    }
    modifier onlyValidator() {
        require(validators[msg.sender], "Not validator");
        _;
    }
    modifier tokenExists(uint256 tokenId) {
        require(_owners[tokenId] != address(0), "Token not exist");
        _;
    }
    modifier onlyTokenCreator(uint256 tokenId) {
        require(events[tokenId].creator == msg.sender, "Not token creator");
        _;
    }
    modifier tokenVerified(uint256 tokenId) {
        require(events[tokenId].verified, "Token not verified");
        _;
    }

    // ==================== 初始化 ====================
    constructor(address initialOwner, address _treasury, address _protocolCreator) {
        require(initialOwner != address(0) && _treasury != address(0) && _protocolCreator != address(0), "Zero address");
        _owner = initialOwner;
        treasury = _treasury;
        protocolCreator = _protocolCreator;
    }

    // ==================== 所有权管理 ====================
    function owner() public view returns (address) { return _owner; }
    function transferOwnership(address newOwner) external onlyOwner {
        require(newOwner != address(0), "Zero address");
        _owner = newOwner;
    }

    function updateProtocolCreator(address newCreator) external onlyOwner {
        require(newCreator != address(0), "Zero address");
        protocolCreator = newCreator;
    }

    function updateTreasury(address newTreasury) external onlyOwner {
        require(newTreasury != address(0), "Zero address");
        treasury = newTreasury;
    }

    // ==================== ERC721 ====================
    function name() external pure returns (string memory) { return NAME; }
    function symbol() external pure returns (string memory) { return SYMBOL; }
    function balanceOf(address owner_) external view returns (uint256) {
        require(owner_ != address(0), "Zero address");
        return _balances[owner_];
    }
    function ownerOf(uint256 tokenId) public view returns (address) {
        address owner_ = _owners[tokenId];
        require(owner_ != address(0), "Token not exist");
        return owner_;
    }
    function approve(address to, uint256 tokenId) external {
        address owner_ = ownerOf(tokenId);
        require(to != owner_, "Approval to current owner");
        require(msg.sender == owner_ || isApprovedForAll(owner_, msg.sender), "Not authorized");
        _tokenApprovals[tokenId] = to;
    }
    function getApproved(uint256 tokenId) external view tokenExists(tokenId) returns (address) {
        return _tokenApprovals[tokenId];
    }
    function isApprovedForAll(address owner_, address operator) public view returns (bool) {
        return _operatorApprovals[owner_][operator];
    }
    function setApprovalForAll(address operator, bool approved) external {
        _operatorApprovals[msg.sender][operator] = approved;
    }
    function transferFrom(address from, address to, uint256 tokenId) public {
        require(_isApprovedOrOwner(msg.sender, tokenId), "Not authorized");
        _transfer(from, to, tokenId);
    }
    function safeTransferFrom(address from, address to, uint256 tokenId) public {
        safeTransferFrom(from, to, tokenId, "");
    }
    function safeTransferFrom(address from, address to, uint256 tokenId, bytes memory data) public {
        require(_isApprovedOrOwner(msg.sender, tokenId), "Not authorized");
        _safeTransfer(from, to, tokenId, data);
    }
    function _isApprovedOrOwner(address spender, uint256 tokenId) internal view returns (bool) {
        address owner_ = ownerOf(tokenId);
        return (spender == owner_ || _tokenApprovals[tokenId] == spender || isApprovedForAll(owner_, spender));
    }
    function _transfer(address from, address to, uint256 tokenId) internal {
        require(ownerOf(tokenId) == from, "Wrong from");
        require(to != address(0), "Zero address");
        _approve(address(0), tokenId);
        _balances[from]--;
        _balances[to]++;
        _owners[tokenId] = to;
    }
    function _approve(address to, uint256 tokenId) internal {
        _tokenApprovals[tokenId] = to;
    }
    function _safeTransfer(address from, address to, uint256 tokenId, bytes memory data) internal {
        _transfer(from, to, tokenId);
        require(_checkOnERC721Received(from, to, tokenId, data), "Transfer not accepted");
    }
    function _checkOnERC721Received(address from, address to, uint256 tokenId, bytes memory data) internal returns (bool) {
        if (to.code.length == 0) return true;
        (bool success, bytes memory ret) = to.call(abi.encodeWithSignature("onERC721Received(address,address,uint256,bytes)", msg.sender, from, tokenId, data));
        return success && (ret.length == 0 || abi.decode(ret, (bytes4)) == 0x150b7a02);
    }
    function _safeMint(address to, uint256 tokenId) internal {
        _mint(to, tokenId);
        require(_checkOnERC721Received(address(0), to, tokenId, ""), "Transfer not accepted");
    }
    function _mint(address to, uint256 tokenId) internal {
        require(to != address(0), "Zero address");
        require(_owners[tokenId] == address(0), "Already minted");
        _balances[to]++;
        _owners[tokenId] = to;
    }

    // ==================== EIP-2981 ====================
    function royaltyInfo(uint256 tokenId, uint256 salePrice) external view tokenExists(tokenId) returns (address receiver, uint256 royaltyAmount) {
        receiver = _royaltyRecipients[tokenId];
        royaltyAmount = (salePrice * _royaltyRates[tokenId]) / 10000;
    }
    function _setTokenRoyalty(uint256 tokenId, address recipient, uint256 rate) internal {
        require(rate <= 10000, "Rate too high");
        _royaltyRecipients[tokenId] = recipient;
        _royaltyRates[tokenId] = rate;
    }

    // ==================== 铸造与证据管理 ====================
    function mint(address to, string memory name_, string memory cid) external returns (uint256) {
        return mintWithSchema(to, 0, name_, cid);
    }
    function mintWithSchema(address to, uint256 schemaId, string memory name_, string memory cid) public returns (uint256) {
        require(to != address(0), "Zero address");
        require(bytes(name_).length > 0, "Name required");
        require(bytes(cid).length > 0, "CID required");

        uint256 tokenId = _tokenIdCounter++;
        _safeMint(to, tokenId);
        _setTokenRoyalty(tokenId, to, 500);
        bytes32 cidHash = keccak256(bytes(cid));

        events[tokenId] = EventProof({
            eventName: name_,
            cid: cid,
            creator: to,
            createTime: block.timestamp,
            verified: false,
            citations: 0,
            revenue: 0,
            validators: new address[](0),
            schemaId: schemaId,
            editionNumber: 0,
            totalEditions: 0
        });

        cidHashs[tokenId] = cidHash;
        evidenceHistory[tokenId].push(cid);
        evidenceCount[tokenId] = 1;

        emit Minted(tokenId, name_, to, schemaId);
        return tokenId;
    }

    function mintEditionSet(address to, uint256 schemaId, string memory eventName, string memory cid, uint256 totalEditions) external returns (uint256[] memory tokenIds) {
        require(to != address(0), "Zero address");
        require(bytes(eventName).length > 0, "Name required");
        require(bytes(cid).length > 0, "CID required");
        require(totalEditions > 0 && totalEditions <= MAX_EDITIONS, "Invalid edition count");
        require(!evidenceCIDMinted[cid], "CID already used");

        evidenceCIDMinted[cid] = true;
        tokenIds = new uint256[](totalEditions);
        bytes32 cidHash = keccak256(bytes(cid));

        for (uint256 i = 0; i < totalEditions; i++) {
            uint256 tokenId = _tokenIdCounter++;
            _safeMint(to, tokenId);
            _setTokenRoyalty(tokenId, to, 500);
            events[tokenId] = EventProof({
                eventName: eventName,
                cid: cid,
                creator: to,
                createTime: block.timestamp,
                verified: false,
                citations: 0,
                revenue: 0,
                validators: new address[](0),
                schemaId: schemaId,
                editionNumber: i + 1,
                totalEditions: totalEditions
            });
            cidHashs[tokenId] = cidHash;
            evidenceHistory[tokenId].push(cid);
            evidenceCount[tokenId] = 1;
            tokenIds[i] = tokenId;
            emit Minted(tokenId, eventName, to, schemaId);
        }
        emit EditionSetMinted(cid, totalEditions, to);
        return tokenIds;
    }

    function addEvidence(uint256 tokenId, string memory newCID) external onlyTokenCreator(tokenId) tokenExists(tokenId) {
        require(bytes(newCID).length > 0, "CID required");
        evidenceHistory[tokenId].push(newCID);
        evidenceCount[tokenId]++;
        emit EvidenceAdded(tokenId, newCID);
    }

    function verifyEvidenceHash(uint256 tokenId, string memory expectedCID) external view tokenExists(tokenId) returns (bool) {
        return cidHashs[tokenId] == keccak256(bytes(expectedCID));
    }

    // ==================== 验证与证明 ====================
    function joinValidator() external {
        require(!validators[msg.sender], "Already validator");
        validators[msg.sender] = true;
        validatorList.push(msg.sender);
        emit ValidatorJoined(msg.sender);
    }

    function verify(uint256 tokenId) external onlyValidator tokenExists(tokenId) {
        EventProof storage proof = events[tokenId];
        require(!proof.verified, "Already verified");
        for (uint i = 0; i < proof.validators.length; i++) {
            require(proof.validators[i] != msg.sender, "Already verified by you");
        }
        proof.validators.push(msg.sender);
        if (proof.validators.length >= MIN_VALIDATORS) proof.verified = true;
        emit Verified(tokenId, msg.sender);
    }

    function addAttestation(uint256 tokenId, string memory commentCID) external onlyValidator tokenExists(tokenId) {
        require(bytes(commentCID).length > 0, "CID required");
        attestations[tokenId].push(Attestation(msg.sender, commentCID, block.timestamp));
        emit AttestationAdded(tokenId, msg.sender, commentCID);
    }

    // ==================== 引用（核心经济模型）====================
    function cite(uint256 tokenId, uint8 level) external payable tokenExists(tokenId) tokenVerified(tokenId) {
        require(level >= 1 && level <= 3, "Invalid level");
        require(!hasCited[tokenId][msg.sender], "Already cited this token");

        (uint256 fee, uint256 weight) = _getFeeAndWeight(level);
        require(msg.value >= fee, "Insufficient fee");

        // 更新被引用者统计
        EventProof storage proof = events[tokenId];
        proof.citations++;
        citationCount[tokenId]++;
        citationWeightedSum[tokenId] += weight;

        citations[tokenId].push(Citation(msg.sender, block.timestamp, level, fee, weight));
        hasCited[tokenId][msg.sender] = true;

        // 收益分配
        uint256 creatorShare = (fee * CREATOR_SHARE) / 100;
        uint256 treasuryShare = (fee * TREASURY_SHARE) / 100;
        uint256 protocolShare = fee - creatorShare - treasuryShare;

        pendingCreatorRevenue[proof.creator] += creatorShare;
        pendingTreasuryRevenue += treasuryShare;
        pendingProtocolCreatorRevenue += protocolShare;
        proof.revenue += creatorShare;

        // 退找零
        if (msg.value > fee) {
            (bool refundSuccess, ) = payable(msg.sender).call{value: msg.value - fee}("");
            require(refundSuccess, "Refund failed");
        }

        emit Cited(tokenId, msg.sender, level, fee, weight);
    }

    function _getFeeAndWeight(uint8 level) internal pure returns (uint256 fee, uint256 weight) {
        if (level == 1) return (FEE_SOCIAL, WEIGHT_SOCIAL);
        if (level == 2) return (FEE_EVIDENCE, WEIGHT_EVIDENCE);
        return (FEE_COMMERCIAL, WEIGHT_COMMERCIAL);
    }

    function getCitationWeightedSum(uint256 tokenId) external view tokenExists(tokenId) returns (uint256) {
        return citationWeightedSum[tokenId];
    }

    function getCitations(uint256 tokenId) external view tokenExists(tokenId) returns (Citation[] memory) {
        return citations[tokenId];
    }

    // ==================== 付费访问 ====================
    function accessFullProof(uint256 tokenId) external payable tokenExists(tokenId) returns (string memory) {
        require(msg.value >= ACCESS_FEE, "Insufficient fee");
        EventProof storage proof = events[tokenId];
        uint256 creatorShare = (msg.value * CREATOR_SHARE) / 100;
        uint256 treasuryShare = (msg.value * TREASURY_SHARE) / 100;
        uint256 protocolShare = msg.value - creatorShare - treasuryShare;
        pendingCreatorRevenue[proof.creator] += creatorShare;
        pendingTreasuryRevenue += treasuryShare;
        pendingProtocolCreatorRevenue += protocolShare;
        return proof.cid;
    }

    // ==================== 手动提现 ====================
    function withdrawCreatorRevenue() external {
        uint256 amount = pendingCreatorRevenue[msg.sender];
        require(amount > 0, "No pending revenue");
        pendingCreatorRevenue[msg.sender] = 0;
        (bool success, ) = payable(msg.sender).call{value: amount}("");
        require(success, "Withdrawal failed");
        emit RevenueWithdrawn(msg.sender, amount, "creator");
    }

    function withdrawTreasuryRevenue() external {
        require(msg.sender == treasury, "Not treasury");
        uint256 amount = pendingTreasuryRevenue;
        require(amount > 0, "No pending revenue");
        pendingTreasuryRevenue = 0;
        (bool success, ) = payable(treasury).call{value: amount}("");
        require(success, "Withdrawal failed");
        treasuryBalance += amount;
        emit RevenueWithdrawn(treasury, amount, "treasury");
    }

    function withdrawProtocolCreatorRevenue() external {
        require(msg.sender == protocolCreator, "Not protocol creator");
        uint256 amount = pendingProtocolCreatorRevenue;
        require(amount > 0, "No pending revenue");
        pendingProtocolCreatorRevenue = 0;
        (bool success, ) = payable(protocolCreator).call{value: amount}("");
        require(success, "Withdrawal failed");
        creatorBalance += amount;
        emit RevenueWithdrawn(protocolCreator, amount, "protocol");
    }

    // ==================== 策展故事线 ====================
    function createStoryline(string memory title, string memory description, bool isPublic) external returns (uint256) {
        require(bytes(title).length > 0, "Title required");
        uint256 storylineId = ++storylineCounter;
        storylines[storylineId] = Storyline({
            id: storylineId,
            title: title,
            description: description,
            creator: msg.sender,
            createdAt: block.timestamp,
            updatedAt: block.timestamp,
            tokenIds: new uint256[](0),
            upvoteCount: 0,
            isPublic: isPublic
        });
        storylinesByCreator[msg.sender].push(storylineId);
        emit StorylineCreated(storylineId, msg.sender, title);
        return storylineId;
    }

    function addToStoryline(uint256 storylineId, uint256 tokenId) external tokenExists(tokenId) {
        require(storylines[storylineId].creator == msg.sender, "Not storyline creator");
        Storyline storage s = storylines[storylineId];
        for (uint i = 0; i < s.tokenIds.length; i++) {
            require(s.tokenIds[i] != tokenId, "Already in storyline");
        }
        s.tokenIds.push(tokenId);
        s.updatedAt = block.timestamp;
        emit TokenAddedToStoryline(storylineId, tokenId);
    }

    function upvoteStoryline(uint256 storylineId) external {
        require(storylines[storylineId].creator != address(0), "Storyline not exist");
        require(!storylineUpvotes[storylineId][msg.sender], "Already upvoted");
        storylineUpvotes[storylineId][msg.sender] = true;
        storylines[storylineId].upvoteCount++;
        emit StorylineUpvoted(storylineId, msg.sender);
    }

    function getStoryline(uint256 storylineId) external view returns (Storyline memory) {
        require(storylines[storylineId].creator != address(0), "Storyline not exist");
        return storylines[storylineId];
    }

    function getStorylineTokenIds(uint256 storylineId) external view returns (uint256[] memory) {
        require(storylines[storylineId].creator != address(0), "Storyline not exist");
        return storylines[storylineId].tokenIds;
    }

    // ==================== 元数据 ====================
    function setBaseURI(string memory baseURI_) external onlyOwner {
        _baseURI = baseURI_;
    }

    function tokenURI(uint256 tokenId) public view tokenExists(tokenId) returns (string memory) {
        if (bytes(_tokenURIs[tokenId]).length > 0) return _tokenURIs[tokenId];
        EventProof storage proof = events[tokenId];
        uint256 weighted = citationWeightedSum[tokenId] / 1e18;
        if (proof.totalEditions > 0) {
            return string(abi.encodePacked(
                _baseURI, '{"name":"', proof.eventName, ' #', proof.editionNumber.toString(), '",',
                '"attributes":[',
                '{"trait_type":"Edition","value":"', proof.editionNumber.toString(), '/', proof.totalEditions.toString(), '"},',
                '{"trait_type":"Verified","value":"', proof.verified ? "true" : "false", '"},',
                '{"trait_type":"Citations","value":', weighted.toString(), '}',
                ']}'
            ));
        } else {
            return string(abi.encodePacked(
                _baseURI, '{"name":"', proof.eventName, '",',
                '"attributes":[',
                '{"trait_type":"Verified","value":"', proof.verified ? "true" : "false", '"},',
                '{"trait_type":"Citations","value":', weighted.toString(), '}',
                ']}'
            ));
        }
    }

    function getEvent(uint256 tokenId) external view tokenExists(tokenId) returns (EventProof memory) {
        return events[tokenId];
    }

    function getValidators() external view returns (address[] memory) {
        return validatorList;
    }

    // ==================== 接口支持 ====================
    function supportsInterface(bytes4 interfaceId) public pure returns (bool) {
        return interfaceId == 0x01ffc9a7 || interfaceId == 0x80ac58cd || interfaceId == 0x5b5e139f || interfaceId == 0x2a55205a;
    }
}
